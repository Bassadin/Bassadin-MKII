---
import SocialIcons from "../SocialIcons.astro";

const currentYear = new Date().getFullYear();
---

<footer
    class="border-t-2 border-stone-400 bg-stone-100 py-9 text-center dark:bg-stone-700"
>
    <h2 class="mb-2 text-2xl font-bold">Social</h2>
    <SocialIcons class="mt-2" />
    <p class="mt-6">
        Source code available on <a
            href="https://github.com/Bassadin/Bassadin-MKII"
            target="_blank"
            class="inline-flex items-center">GitHub</a>
    </p>
    <p class="mt-1">
        <a href="/legal">Legal info and data protection</a>
    </p>
    <p class="mt-8">©️{currentYear} by Bastian Hodapp</p>
</footer>
